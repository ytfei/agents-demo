# ---- LLM ----
DEEPSEEK_API_KEY=your-deepseek-key

# ---- 存储（生产必需；本地 demo 可留空，会自动回退到 JSON 文件 store）----
# psycopg 连接串；postgres + pgvector
DATABASE_URL=postgresql://agent:agent_pass@localhost:5432/agent_mem

# ---- Redis（会话锁 + 限流）----
REDIS_URL=redis://localhost:6379/0

# ---- 服务 ----
WEB_CONCURRENCY=8            # uvicorn worker 数（每 worker 一个 asyncio 事件循环 + 一份 agent 单例 + 一份 PG 连接池）
RATE_LIMIT_PER_USER=10       # 每用户每秒最大请求数

# ---- LangSmith 可观测性（按需开启，10W 下建议采样而非全量）----
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=StockAnalyzer
LANGSMITH_API_KEY=
