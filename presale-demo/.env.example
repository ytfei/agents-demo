# ---- LLM ----
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat

# ---- 存储（生产必需；必须指向 Postgres，提供 checkpoint + 长期记忆）----
DATABASE_URL=postgresql://agent:agent_pass@localhost:5432/agent_mem

# ---- Redis（会话锁 + 限流）----
REDIS_URL=redis://localhost:6379/0

# ---- 服务 ----
PORT=8000
WEB_CONCURRENCY=4            # cluster worker 数（每 worker 一个事件循环 + 一份 agent 单例 + 一份 PG 连接池）
RATE_LIMIT_PER_USER=10       # 每用户每秒最大请求数
SESSION_LOCK_TTL=30          # 会话锁 TTL（秒）

# ---- 版本号（/healthz 返回）----
# 默认自动生成格式：v<semver>-<channel>-<timestamp>，如 v0.01-dev-20260814034503
# 时间戳取进程启动时刻，每次部署唯一，便于区分实例。
# 可显式覆盖（生产固定版本）：
# APP_VERSION=v1.2.0-prod-20260814
# 或只调通道/版本：
# APP_SEMVER=0.01
# APP_CHANNEL=dev

# ---- LangSmith 可观测性（按需开启，10W 下建议采样而非全量）----
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=PresalesAgent
LANGSMITH_API_KEY=
